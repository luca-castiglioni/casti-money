# Copia questo file in ".env.local" e inserisci i valori del tuo progetto Supabase
# (Supabase → Project Settings → API).
# La "anon/publishable key" è pensata per stare nel browser: i dati sono protetti
# dalle regole di sicurezza (RLS) definite in supabase/schema.sql.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=incolla-qui-la-anon-key
